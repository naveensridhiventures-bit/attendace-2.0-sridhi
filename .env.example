# Frontend env vars (Vite) — copy this file to .env.local
#
# On Vercel, the frontend and the Python API live in the SAME project/domain,
# so you normally do NOT need to set this at all (api.js defaults to '/api').
# Only set it if your API is hosted on a different domain than the frontend.
# VITE_API_URL=https://your-backend.vercel.app/api

# ---------------------------------------------------------------------------
# Backend env vars — set these in Vercel Project Settings > Environment
# Variables (NOT in this file; this file is only for the frontend's Vite vars)
# ---------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON   the full service-account JSON, minified to one line
# SHEET_ID                      the spreadsheet ID from its URL
# VAPID_PUBLIC_KEY              optional, for web push (npx web-push generate-vapid-keys)
# VAPID_PRIVATE_KEY             optional, for web push

